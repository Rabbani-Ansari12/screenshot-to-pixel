# Edge Function secrets. Copy to supabase/secrets.env (gitignored), fill in real values, then:
#   npx supabase secrets set --env-file supabase/secrets.env
# Any value still starting with REPLACE_ME makes getSecret() throw a clear error.
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY
# Default recommendation: gemini-3.6-flash (see docs/ai-pipeline.md)
GEMINI_MODEL=REPLACE_ME_GEMINI_MODEL
APP_ORIGIN=http://localhost:5173
OWNER_EMAIL=REPLACE_ME_OWNER_EMAIL
OWNER_PASSWORD=REPLACE_ME_OWNER_PASSWORD
